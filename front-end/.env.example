# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/test?retryWrites=true&w=majority

# JWT Authentication Secret (replace with a random 32+ character string)
TOKEN_SECRET=replace_with_a_secure_random_jwt_secret_key

# Application URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_AI_URL=http://localhost:8000

# Google Gemini API Key (for NLP & AI recommendations)
GEMINI_API_KEY=your_google_gemini_api_key

# Hugging Face Token (optional for translations & embeddings)
HUGGINGFACE_TOKEN=your_huggingface_token

# Admin account seeding (used by scripts/seedAdmin.ts)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure_admin_password

# SMTP Email setup (optional, for password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com
